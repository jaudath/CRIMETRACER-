# CrimeTracer Backend Configuration

# Database Configuration
# For PostgreSQL (production):
# DATABASE_URL=postgresql://username:password@localhost:5432/crimetracer
# For SQLite fallback (development):
# DATABASE_URL=sqlite:///crime_tracer.db

# JWT Security
JWT_SECRET=change-this-to-a-secure-random-string-in-production
JWT_EXPIRATION_HOURS=8

# Default Admin User (created on first run)
DEFAULT_ADMIN_PASSWORD=admin123

# AWS Configuration (Optional - system works without these)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=ap-south-1

# S3 File Storage (Optional - falls back to local storage)
S3_BUCKET=crimetracer-uploads

# SNS Messaging (Optional - falls back to mock SMS)
SNS_TOPIC_ARN=arn:aws:sns:ap-south-1:123456789012:crimetracer-notifications

# AI/ML Configuration (Optional - falls back to rule-based)
GEMINI_API_KEY=your_gemini_api_key

# Rate Limiting Configuration
MAX_COMPLAINTS_PER_PHONE_PER_HOUR=5
RATE_LIMIT_WINDOW_MINUTES=60

# File Upload Limits
MAX_FILE_SIZE_MB=10
MAX_ATTACHMENTS_PER_COMPLAINT=5

# Victim Confirmation Window
VICTIM_CONFIRM_WINDOW_HOURS=24

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/crimetracer.log

# CORS Configuration (Frontend URLs)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000

# Email Configuration (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# Development Settings
DEBUG=false
TESTING=false

# Security Headers
ENABLE_SECURITY_HEADERS=true
ENABLE_RATE_LIMITING=true

# Station Assignment
AUTO_ASSIGN_NEAREST_STATION=true
MAX_STATION_DISTANCE_KM=50

# Background Jobs
ENABLE_BACKGROUND_JOBS=true
CLEANUP_OLD_LOGS_DAYS=30